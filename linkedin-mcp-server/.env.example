# Port where Chrome is listening with remote debugging enabled.
# Start Chrome with: google-chrome --remote-debugging-port=9222
# Or: open -a "Google Chrome" --args --remote-debugging-port=9222  (macOS)
CHROME_DEBUG_PORT=9222

# Optional: path to a Chrome user data directory so the server can launch
# Chrome with your existing profile (and saved LinkedIn session) if Chrome
# isn't already running.
# macOS default: ~/Library/Application Support/Google/Chrome/Default
# Linux default: ~/.config/google-chrome/Default
# CHROME_USER_DATA_DIR=/path/to/your/chrome/profile
